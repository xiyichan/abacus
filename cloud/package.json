{
  "name": "abacus-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8790",
    "migrate:local": "wrangler d1 migrations apply abacus --local",
    "deploy": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler deploy",
    "deploy:dev": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler deploy --env dev",
    "migrate:remote": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler d1 migrations apply abacus --remote",
    "migrate:remote:dev": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler d1 migrations apply abacus-dev --remote --env dev",
    "secret:dev": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler secret put --env dev",
    "logs": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler tail",
    "logs:dev": "XDG_CONFIG_HOME=$PWD/.wrangler-home wrangler tail --env dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
